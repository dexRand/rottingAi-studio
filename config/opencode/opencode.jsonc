{
  // OpenCode V2 configuration for the local llama-server runtime.
  // Copy to the project root as `opencode.jsonc` (or to ~/.config/opencode/).
  // llama-server must be running with --jinja (see scripts/start.sh).
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "local": {
      "name": "Local llama.cpp (router)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        // The router proxy (public port). It adds the add-ons chosen for each
        // request, then forwards to llama-server (internal, 127.0.0.1:8081).
        "baseURL": "http://127.0.0.1:8080/v1"
        // Se imposti LLAMA_API_KEY in .env, esportala e decommenta:
        // "apiKey": "{env:LLAMA_API_KEY}"
      },
      // One base model always loaded: no model switching during work.
      // `lite` and `ctf` are alternatives you start explicitly (./ai start lite|ctf).
      "models": {
        "base": {
          "modelID": "qwen3.5-9b",
          "name": "Base (local, router)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 16384, "output": 8192 }
        },
        "lite": {
          "modelID": "qwen3.5-4b",
          "name": "Lite (local, router)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 16384, "output": 8192 }
        },
        "ctf": {
          "modelID": "whiterabbitneo-7b",
          "name": "CTF (local, exception)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 16384, "output": 8192 }
        }
      }
    }
  },

  // Default model for new sessions (change with /models at any time).
  "model": "local/base",

  // StegSuite (CTF toolbox, ~/Progetti/ctf-docker) via MCP. Used only when it is up:
  // if StegSuite is not running, the connection fails in 3 s and OpenCode simply
  // starts without its tools (`opencode mcp list` shows the state). Start it with
  // `./ctf up` in the ctf-docker repo. Files to analyze: ctf-docker/data/inbox/.
  "mcp": {
    "servers": {
      "stegsuite": {
        "type": "remote",
        "url": "http://127.0.0.1:19014/api/v1/mcp",
        "oauth": false,          // API key only (header), no OAuth
        "codemode": false,       // native tool list: better for small local models
        "timeout": { "startup": 3000, "execution": 330000 }  // analyze(wait_s=300)
        // with STEGSUITE_API_KEY set in ctf-docker/.env:
        // "headers": { "X-API-Key": "{env:STEGSUITE_API_KEY}" }
      }
    }
  }
}
