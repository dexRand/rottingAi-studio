#!/usr/bin/env bash
# ============================================================================
# rottingAi-studio — main CLI
#
#   ./ai chat [role]        start server (if needed) + open the built-in web UI
#   ./ai code               coding model (Qwen2.5-Coder-7B)
#   ./ai sysadmin           sysadmin model (Qwen2.5-7B Q5)
#   ./ai sysadmin-heavy     optional heavy sysadmin (Gemma 3 12B)
#   ./ai cli [role]         terminal chat via llama-cli (no server)
#   ./ai start <role>       start llama-server only
#   ./ai stop               stop and free RAM
#   ./ai status             runtime + model + RAM status
#   ./ai logs               follow the server log
#   ./ai download [--all|<role>]
#   ./ai benchmark <role> [threads]
#   ./ai upgrade [all|runtime|skills|check]
#   ./ai healthcheck        integrity + health
#   ./ai help
# ============================================================================
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -f "$REPO_DIR/.env" ] && source "$REPO_DIR/.env"
HOST="${LLAMA_HOST:-127.0.0.1}"
PORT="${LLAMA_PORT:-8080}"
MODELS_DIR="${MODELS_DIR:-$HOME/local-ai/models}"
LLAMA_CLI_BIN="${LLAMA_CLI_BIN:-llama-cli}"
LOG_FILE="$REPO_DIR/runtime/llama-server.log"

usage() {
  cat <<'EOF'
Usage: ./ai <command> [args]

  chat [role]        start server (if needed) + open the built-in web UI
  code               coding model (Qwen2.5-Coder-7B)
  sysadmin           sysadmin model (Qwen2.5-7B Q5)
  sysadmin-heavy     optional heavy sysadmin (Gemma 3 12B)
  cli [role]         terminal chat via llama-cli (no server)
  start <role>       start llama-server only
  stop               stop and free RAM
  status             runtime + model + RAM status
  logs               follow the server log
  download [--all|<role>]
  benchmark <role> [threads]
  upgrade [all|runtime|skills|check]
  healthcheck        integrity + health
  help               this help

Roles: coder | general | sysadmin | sysadmin-heavy
EOF
}

open_browser() {
  local url="http://127.0.0.1:$PORT"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
  echo "Web UI (local): $url"
  echo "API (OpenAI):   $url/v1"
  if [ "$HOST" = "0.0.0.0" ]; then
    echo "LAN access:"
    for ip in $(hostname -I 2>/dev/null); do
      echo "   http://$ip:$PORT/v1"
    done
  fi
}

ensure_server() {
  local role="$1"
  if ! "$REPO_DIR/scripts/start.sh" "$role"; then
    echo "note: could not start '$role' (see above). To switch models: ./ai stop first."
  fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  chat)
    role="${1:-general}"
    ensure_server "$role"
    open_browser
    ;;
  code)          ensure_server coder; open_browser ;;
  sysadmin)       ensure_server sysadmin; open_browser ;;
  sysadmin-heavy) ensure_server sysadmin-heavy; open_browser ;;
  cli)
    role="${1:-general}"
    source "$REPO_DIR/config/llama.cpp/roles.conf"
    MODEL_VAR="${role^^}_MODEL"; CTX_VAR="${role^^}_CTX"; THREADS_VAR="THREADS_${role^^}"
    MODEL="${!MODEL_VAR:-}"; CTX="${!CTX_VAR:-16384}"; THREADS="${!THREADS_VAR:-4}"
    [ -n "$MODEL" ] || { echo "unknown role: $role" >&2; exit 2; }
    [ -f "$MODELS_DIR/$MODEL" ] || { echo "model not found: $MODELS_DIR/$MODEL" >&2; exit 1; }
    exec "$LLAMA_CLI_BIN" -m "$MODELS_DIR/$MODEL" -c "$CTX" -t "$THREADS" -cnv
    ;;
  start)      "$REPO_DIR/scripts/start.sh" "$@" ;;
  stop)       "$REPO_DIR/scripts/stop.sh" ;;
  status)     "$REPO_DIR/scripts/status.sh" ;;
  logs)
    if [ ! -f "$LOG_FILE" ]; then
      echo "no log yet (server never started): $LOG_FILE" >&2
      exit 1
    fi
    exec tail -f "$LOG_FILE"
    ;;
  download)   "$REPO_DIR/scripts/download-models.sh" "${@:---all}" ;;
  benchmark)  "$REPO_DIR/scripts/benchmark.sh" "$@" ;;
  upgrade)    "$REPO_DIR/scripts/upgrade.sh" "${@:-all}" ;;
  healthcheck) "$REPO_DIR/scripts/healthcheck.sh" ;;
  help|--help|-h) usage ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
