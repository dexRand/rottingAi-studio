#!/usr/bin/env bash
# ============================================================================
# rottingAi-studio — main CLI
#
# One base model always loaded + a router that adds add-ons to the context
# (see CLAUDE.md). No model switching during normal use.
#
#   ./ai                     chat session with the local agent (current dir)
#   ./ai "prompt"            same, starting with this prompt (-p = one shot)
#   ./ai -s "prompt"         stealth: quiet one shot, final answer as a notification
#   ./ai agent [-y] [-p] [-s] [--no-think] ["prompt"]
#   ./ai chat                start model + router (if needed) + open the web UI
#   ./ai start [role]        start model + router only (role: base | lite | ctf)
#   ./ai stop                stop everything and free RAM
#   ./ai status              model + router + RAM status
#   ./ai logs [router]       follow the llama-server (or router) log
#   ./ai cli [role]          terminal chat via llama-cli (no server, no router)
#   ./ai route "testo" [--file F] [--show]   show what the router would pick
#   ./ai route-eval [file.jsonl]             router accuracy on labelled examples
#   ./ai route-train <dataset.jsonl...>      fit + save the tf-idf classifier (needs sklearn)
#   ./ai router-install      venv with Magika (+ experimental GLiClass)
#   ./ai download [--all|<role>]
#   ./ai setup [--all] [--no-router]  one-shot: binaries check + models + router deps
#   ./ai benchmark [role] [threads]
#   ./ai upgrade [all|runtime|skills|check]
#   ./ai healthcheck         integrity + health
#   ./ai test [--skills-only] [--models ROLES...]   fleet orchestrator
#   ./ai help
# ============================================================================
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"
LLAMA_CLI_BIN="${LLAMA_CLI_BIN:-llama-cli}"

usage() {
  cat <<'EOF'
Usage: ./ai                 chat with the local agent in a NEW terminal window (same directory)
       ./ai "prompt"        same, starting with this prompt
       ./ai -a "prompt"     auto mode: runs commands / edits files WITHOUT asking
       ./ai -p "prompt"     one shot in this terminal: answer and exit
       ./ai -s "prompt"     stealth: quiet one shot, answer via notify-send (fallback: stderr)
       ./ai --here          chat in this terminal instead of a new window
       ./ai <command> [args]

  agent [-y] [-p] [-s] [--no-think] ["prompt"]
                     local agent; no prompt = interactive. Every command and
                     file change asks approval (-y = approve all). Shows the
                     model's thinking, tool calls and KV-cache stats.
                     -s/--stealth: no terminal output, one shot, auto-approve;
                     sends the final answer with notify-send.
  chat               start model + router (if needed) + open the web UI
  start [role]       start model + router only
  stop               stop everything and free RAM
  status             model + router + RAM status
  logs [router]      follow the llama-server (or router) log
  cli [role]         terminal chat via llama-cli (no server, no router)
  route "text" [--file F] [--history "msg"] [--show]
                     show the category + add-ons the router would pick
  route-eval [file.jsonl] [--backend B] [-v]
                     router accuracy on labelled examples
  route-train <dataset.jsonl...>
                     fit + save the tf-idf classifier (needs sklearn)
  router-check       validate addons/registry.toml and add-on sizes
  router-install [--gliclass] [--tfidf]
                     create .venv with Magika (+ experimental GLiClass)

  tfidf backend: ./ai router-install --tfidf, then ./ai route-train <dataset.jsonl...>
  download [--all|<role>]
  setup [--all] [--no-router]
                     one-shot first-run: check llama-server binary, download the
                     default model (+ lite/ctf with --all), install router deps
  benchmark [role] [threads]
  upgrade [all|runtime|skills|check]
  healthcheck        integrity + health
  test [--skills-only] [--models ROLES...]   fleet orchestrator
  help               this help

Roles: base (default, always on) | lite (smaller alternative) | ctf (rare exception)
EOF
}

open_browser() {
  local url="http://127.0.0.1:$PUBLIC_PORT"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
  echo "Web UI (local): $url"
  echo "API (OpenAI):   $url/v1"
  if [ "$PUBLIC_HOST" = "0.0.0.0" ]; then
    echo "LAN access:"
    for ip in $(hostname -I 2>/dev/null); do
      echo "   http://$ip:$PUBLIC_PORT/v1"
    done
  fi
}

# Open the chat in a NEW terminal window (same directory), leaving this shell free.
# Terminal: $AI_TERMINAL, $TERMINAL, or the first one found below.
spawn_terminal() {
  local term="" t cmd
  for t in "${AI_TERMINAL:-}" "${TERMINAL:-}" kitty konsole gnome-terminal alacritty foot \
           xfce4-terminal wezterm x-terminal-emulator xterm; do
    [ -n "$t" ] && command -v "$t" >/dev/null 2>&1 && { term="$t"; break; }
  done
  [ -n "$term" ] || return 1
  # AI_SPAWNED stops the new window from spawning yet another one; on an error
  # exit the window waits, so the message can be read before it closes.
  cmd="AI_SPAWNED=1 $(printf '%q ' "$REPO_DIR/ai" "$@"); s=\$?; \
[ \$s -eq 0 ] || read -rp \"ai è uscito con errore \$s: premi invio per chiudere \""
  case "$(basename "$term")" in
    kitty)          setsid -f kitty --directory "$PWD" --title "ai" bash -c "$cmd" ;;
    konsole)        setsid -f konsole --workdir "$PWD" -e bash -c "$cmd" ;;
    gnome-terminal) setsid -f gnome-terminal --working-directory="$PWD" -- bash -c "$cmd" ;;
    alacritty)      setsid -f alacritty --working-directory "$PWD" -e bash -c "$cmd" ;;
    foot)           setsid -f foot -D "$PWD" bash -c "$cmd" ;;
    wezterm)        setsid -f wezterm start --cwd "$PWD" -- bash -c "$cmd" ;;
    *)              setsid -f "$term" -e bash -c "$cmd" ;;   # inherits $PWD
  esac >/dev/null 2>&1 || return 1
  echo "ai: chat aperta in una nuova finestra ($(basename "$term"), $PWD)"
}

agent_cmd() {
  # stealth (-s): run detached in the background, notify when done, free the shell
  local a stealth=0 here=0
  for a in "$@"; do
    case "$a" in -s|--stealth) stealth=1 ;; -p|--print|--here) here=1 ;; esac
  done
  if [ "$stealth" = 1 ]; then
    PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}" \
      AGENT_URL="http://127.0.0.1:$PUBLIC_PORT" \
      setsid -f "$(router_python)" -m agent "$@" >/dev/null 2>>"$RUNTIME_DIR/stealth.log"
    exit 0
  fi
  # new window unless: one shot (-p), --here, already inside one, or no graphical session
  if [ "$here" = 0 ] && [ -z "${AI_SPAWNED:-}" ] && [ -t 1 ] \
     && { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
    spawn_terminal "$@" && exit 0
    echo "ai: nessun terminale grafico trovato, apro la chat qui" >&2
  fi
  # keep the user's current directory: the agent works where you call it
  PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}" \
    AGENT_URL="http://127.0.0.1:$PUBLIC_PORT" exec "$(router_python)" -m agent "$@"
}

router_cmd() {
  cd "$REPO_DIR" && exec "$(router_python)" -m router "$@"
}

# no arguments: open the agent chat session in the current directory
[ $# -eq 0 ] && agent_cmd
cmd="$1"
shift

case "$cmd" in
  chat)
    "$REPO_DIR/scripts/start.sh" "${1:-$DEFAULT_ROLE}"
    open_browser
    ;;
  start)      "$REPO_DIR/scripts/start.sh" "$@" ;;
  stop)       "$REPO_DIR/scripts/stop.sh" ;;
  status)     "$REPO_DIR/scripts/status.sh" ;;
  logs)
    log="$LLAMA_LOG_FILE"
    [ "${1:-}" = "router" ] && log="$ROUTER_LOG_FILE"
    [ -f "$log" ] || { echo "no log yet (never started): $log" >&2; exit 1; }
    exec tail -f "$log"
    ;;
  cli)
    role="${1:-$DEFAULT_ROLE}"
    MODEL_VAR="${role^^}_MODEL"; CTX_VAR="${role^^}_CTX"; THREADS_VAR="THREADS_${role^^}"
    MODEL="${!MODEL_VAR:-}"; CTX="${!CTX_VAR:-16384}"; THREADS="${!THREADS_VAR:-${THREADS:-4}}"
    [ -n "$MODEL" ] || { echo "unknown role: $role" >&2; exit 2; }
    [ -f "$MODELS_DIR/$MODEL" ] || { echo "model not found: $MODELS_DIR/$MODEL" >&2; exit 1; }
    LLAMA_CLI="$(llama_bin llama-cli "$LLAMA_CLI_BIN")" || { echo "llama-cli not found" >&2; exit 1; }
    exec "$LLAMA_CLI" -m "$MODELS_DIR/$MODEL" -c "$CTX" -t "$THREADS" -cnv \
      -sys "$REPO_DIR/config/system-prompts/terse.txt"
    ;;
  route)          router_cmd route "$@" ;;
  route-eval)     router_cmd eval "$@" ;;
  route-train)    router_cmd train "$@" ;;
  router-check)   router_cmd check ;;
  router-install)
    python3 -m venv "$REPO_DIR/.venv"
    "$REPO_DIR/.venv/bin/pip" install --upgrade pip
    "$REPO_DIR/.venv/bin/pip" install -r "$REPO_DIR/router/requirements.txt"
    for flag in "$@"; do
      case "$flag" in
        --gliclass)
          # CPU-only PyTorch wheels: avoids a multi-GB CUDA download
          "$REPO_DIR/.venv/bin/pip" install --extra-index-url https://download.pytorch.org/whl/cpu \
            -r "$REPO_DIR/router/requirements-gliclass.txt"
          ;;
        --tfidf)
          "$REPO_DIR/.venv/bin/pip" install -r "$REPO_DIR/router/requirements-tfidf.txt"
          ;;
      esac
    done
    echo "Router venv ready: $REPO_DIR/.venv (restart with ./ai stop && ./ai start)"
    ;;
  download)   "$REPO_DIR/scripts/download-models.sh" "${@:-$DEFAULT_ROLE}" ;;
  setup)      "$REPO_DIR/scripts/setup.sh" "$@" ;;
  benchmark)  "$REPO_DIR/scripts/benchmark.sh" "${1:-$DEFAULT_ROLE}" "${@:2}" ;;
  upgrade)    "$REPO_DIR/scripts/upgrade.sh" "${@:-all}" ;;
  healthcheck) "$REPO_DIR/scripts/healthcheck.sh" ;;
  test)       cd "$REPO_DIR" && exec "$(router_python)" "$REPO_DIR/scripts/orchestrate.py" "$@" ;;
  agent)      agent_cmd "$@" ;;
  help|--help|-h) usage ;;
  -*)        agent_cmd "$cmd" "$@" ;;   # agent options: -p, -a, -s, --no-think
  *)
    # anything that is not a command is a prompt for the agent
    agent_cmd "$cmd" "$@"
    ;;
esac
