# ============================================================================
# rottingAi-studio — local configuration
# Copy this file to `.env` and adjust the values. `.env` is git-ignored.
# ============================================================================

# Directory where the GGUF model files live (OUTSIDE the repo, never versioned)
MODELS_DIR="$HOME/local-ai/models"

# Public endpoint = the router proxy (OpenAI-compatible, adds the add-ons).
#   127.0.0.1 = solo locale (default, più sicuro)
#   0.0.0.0   = raggiungibile dalla LAN / da altre app via API (solo se serve)
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080

# llama-server is internal: always bound to 127.0.0.1, reached via the router.
LLAMA_PORT=8081

# 1 = router in front of llama-server (default). 0 = llama-server alone on
# LLAMA_PORT, no add-ons (useful to compare answers with/without add-ons).
ROUTER_ENABLED=1

# API key opzionale: se impostata, llama-server (anche via router) richiede
# "Authorization: Bearer <key>" sugli endpoint /v1. Vuoto = nessuna auth.
LLAMA_API_KEY=

# Memory (16 GB machines): number of parallel conversations and RAM for the
# prompt cache (MiB). llama-server's own defaults (4 slots, 8192 MiB) push the
# model out of RAM and generation drops to ~1 t/s.
LLAMA_PARALLEL=1
LLAMA_CACHE_RAM=1024

# Paths to the llama.cpp binaries (override if built from source into ~/.local/bin)
LLAMA_SERVER_BIN=llama-server
LLAMA_CLI_BIN=llama-cli

# CPU threads. Default 4 = physical cores of the i5-8350U.
# Tune after running `./ai benchmark` (SMT usually does NOT help here).
# Per-role override: THREADS_BASE / THREADS_LITE / THREADS_CTF.
THREADS=4

# Optional: Open WebUI (GUI) port, used by `docker compose --profile gui`
WEBUI_PORT=3000
