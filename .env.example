# ============================================================================
# rottingAi-studio — local configuration
# Copy this file to `.env` and adjust the values. `.env` is git-ignored.
# ============================================================================

# Directory where the GGUF model files live (OUTSIDE the repo, never versioned)
MODELS_DIR="$HOME/local-ai/models"

# llama-server network binding:
#   127.0.0.1 = solo locale (default, più sicuro)
#   0.0.0.0   = raggiungibile dalla LAN / da altre app via API (solo se serve)
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# API key opzionale: se impostata, llama-server richiede
# "Authorization: Bearer <key>" sugli endpoint /v1. Vuoto = nessuna auth.
LLAMA_API_KEY=

# Paths to the llama.cpp binaries (override if built from source into ~/.local/bin)
LLAMA_SERVER_BIN=llama-server
LLAMA_CLI_BIN=llama-cli

# CPU threads per role. Default 4 = physical cores of the i5-8350U.
# Tune after running `./scripts/benchmark.sh` (SMT usually does NOT help here).
THREADS_CODER=4
THREADS_GENERAL=4
THREADS_FAST=4
THREADS_CTF=4
THREADS_SYSADMIN=4
THREADS_SYSADMIN_HEAVY=4

# Optional: Open WebUI (GUI) port, used by `docker compose --profile gui`
WEBUI_PORT=3000

# ----------------------------------------------------------------------------
# Colibri "super-heavy" (Qwen3.6-35B-A3B, 35B MoE) — SEPARATE runtime, NOT
# llama.cpp. Requires the colibri repo and the 23 GB model OUTSIDE this repo:
#   git clone https://github.com/JustVugg/colibri ~/colibri
#   cd ~/colibri && python3 c/coli setup --yes --model qwen36-35b --no-start
# Start/stop it with: ./scripts/colibri.sh start|stop|status  (or ./ai super-heavy)
# ----------------------------------------------------------------------------
COLIBRI_DIR="$HOME/colibri"
COLIBRI_MODEL="$HOME/colibri-models/qwen36-35b"
COLIBRI_PORT=8000
COLIBRI_CAP=120          # expert cache slots/layer — the knob that matters (auto-detect is too small on 16 GB)
COLIBRI_CTX=16384        # context; lower = more RAM left for the expert cache
COLIBRI_MODEL_ID=qwen3.6-colibri
